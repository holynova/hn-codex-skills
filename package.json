{
  "name": "hn-codex-skills",
  "version": "0.2.0",
  "description": "Installer package for HN personal Codex skills.",
  "homepage": "https://github.com/holynova/hn-codex-skills",
  "type": "module",
  "bin": {
    "hn-codex-skills": "./bin/install.mjs"
  },
  "files": [
    "bin/",
    "skills/"
  ],
  "scripts": {
    "install-skills": "node ./bin/install.mjs install",
    "check": "node ./bin/install.mjs --dry-run --path ./node_modules/.hn-codex-skills-check",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codex",
    "skills",
    "agent",
    "workflow"
  ],
  "license": "MIT"
}
